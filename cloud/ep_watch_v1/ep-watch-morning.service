[Unit]
Description=EP forward paper watch: 10:50 watch-list email (read-only market data and SEC filings, no orders)
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=ep-watch
Group=ep-watch
WorkingDirectory=/opt/ep-watch
Environment=PYTHONPATH=/opt/ep-watch
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u -m research.ep_watch_v1.watch --morning
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/ep-watch/outputs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
