[Unit]
Description=SPY bull put spread paper bot v1 (Alpaca paper trading only)
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=options-bot
Group=options-bot
WorkingDirectory=/opt/spy-put-spread-bot
Environment=PYTHONPATH=/opt/spy-put-spread-bot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u -m research.spy_put_spread_v1.bot
TimeoutStartSec=20min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/spy-put-spread-bot/outputs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
