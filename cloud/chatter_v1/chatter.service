[Unit]
Description=LITE chatter: 16:15 email of Stocktwits + WallStreetBets posts on LITE, MU, COHR, AAOI (read-only)
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=chatter
Group=chatter
WorkingDirectory=/opt/chatter
Environment=PYTHONPATH=/opt/chatter
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u -m research.chatter_v1.report
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/chatter/outputs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
