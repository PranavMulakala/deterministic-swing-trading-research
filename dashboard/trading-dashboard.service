[Unit]
Description=Private personal Research Desk (read-only)
After=network.target
ConditionPathExists=/var/lib/trading-collector/archive.sqlite

[Service]
Type=simple
User=trading-collector
Group=trading-collector
WorkingDirectory=/opt/trading-dashboard-20260915-paper-runtime-v1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m dashboard.server --cloud-local --port 8766
Restart=on-failure
RestartSec=15
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/trading-collector /var/lib/trading-research /var/lib/agentic-paper-runtime /opt/trading-research-v3-20260915-orb-direct-v1
InaccessiblePaths=/etc/trading-collector
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
CPUQuota=20%
TasksMax=24
UMask=0077

[Install]
WantedBy=multi-user.target
